@model foodOrder.Models.Pedido

@{
    ViewData["Title"] = "Eliminar pedido";
}

<div class="container mt-4">
    <h2>Eliminar pedido</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <h5>¿Estás seguro de que deseas eliminar este pedido?</h5>

            <dl class="row mt-3">
                <dt class="col-sm-3">Código</dt>
                <dd class="col-sm-9">@Model.IdPedido</dd>

                <dt class="col-sm-3">Fecha</dt>
                <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">@Model.Estado</dd>

                <dt class="col-sm-3">Cliente</dt>
                <dd class="col-sm-9">@Model.Cliente?.Nombre</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="IdPedido" />

                <button type="submit" class="btn btn-danger">
                    Confirmar eliminación
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </form>
        </div>
    </div>
</div>