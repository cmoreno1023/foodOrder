@model foodOrder.Models.Pedido

@{
    ViewData["Title"] = "Editar pedido";
}

<div class="container mt-4">
    <h2>Editar pedido</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="IdPedido" />

                <div class="mb-3">
                    <label asp-for="Fecha" class="form-label">Fecha del pedido</label>
                    <input asp-for="Fecha" type="datetime-local"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select">
                        <option value="Pendiente">Pendiente</option>
                        <option value="En preparación">En preparación</option>
                        <option value="Entregado">Entregado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="IdCliente" class="form-label">Cliente</label>
                    <select asp-for="IdCliente"
                            asp-items="ViewBag.IdCliente"
                            class="form-select">
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Volver
                </a>

            </form>
        </div>
    </div>
</div>