@model foodOrder.Models.Cliente

@{
    ViewData["Title"] = "Detalles del cliente";
}

<div class="container mt-4">
    <h2>Detalles del cliente</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Código</dt>
                <dd class="col-sm-9">@Model.IdCliente</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Teléfono</dt>
                <dd class="col-sm-9">@Model.Telefono</dd>

                <dt class="col-sm-3">Correo</dt>
                <dd class="col-sm-9">@Model.Correo</dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.IdCliente"
               class="btn btn-warning">Editar</a>

            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</div>