@model IEnumerable<foodOrder.Models.DetallePedido>

@{
    ViewData["Title"] = "Detalles de pedidos";
}

<h1>Detalles de pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar detalle</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Pedido</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model)
        {
            <tr>
                <td>@detalle.IdPedido</td>
                <td>@detalle.Producto?.Nombre</td>
                <td>@detalle.Cantidad</td>
                <td>@detalle.PrecioUnitario</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@detalle.IdDetalle">Editar</a> |
                    <a asp-action="Details" asp-route-id="@detalle.IdDetalle">Ver</a> |
                    <a asp-action="Delete" asp-route-id="@detalle.IdDetalle">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>